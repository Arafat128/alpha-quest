# Neon pooled URL for the app (host contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon direct URL for prisma db push (same host without -pooler).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# 32+ characters
SESSION_SECRET="replace-with-a-long-random-session-secret!!"
ADMIN_SECRET="replace-admin-secret"

NEXT_PUBLIC_PRIMUS_APP_ID=
PRIMUS_APP_ID=
# Server only — used to sign attestation requests. Never expose to the client.
PRIMUS_APP_SECRET=

# Hub template whose Request URL is https://x.com/i/api/graphql/.*/UserByScreenName\?.*
PRIMUS_TEMPLATE_X_FOLLOW=674142ce-d852-4c1d-9ca3-3061ace98988
PRIMUS_TEMPLATE_X_POST=
PRIMUS_TEMPLATE_DISCORD_JOIN=
PRIMUS_TEMPLATE_DISCORD_ROLE=
PRIMUS_VERIFIER_ADDRESS=
RPC_URL=

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

X_CLIENT_ID=
X_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_INVITE_URL=

RESEND_API_KEY=
EMAIL_FROM=
