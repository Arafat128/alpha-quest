{
  "name": "primus-quest-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma db push --force-reset && node prisma/seed.js",
    "e2e": "node scripts/e2e.mjs",
    "e2e:local": "node scripts/e2e.mjs http://localhost:3000",
    "e2e:prod": "node scripts/e2e.mjs https://alpha-quest-kappa.vercel.app"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@primuslabs/zktls-ext-core-sdk": "^0.2.4",
    "@primuslabs/zktls-page-core-sdk": "^0.2.1",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.62.11",
    "clsx": "^2.1.1",
    "ethers": "^5.7.2",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.44.0",
    "next": "^14.2.35",
    "prisma": "^5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "siwe": "^2.3.2",
    "viem": "^2.21.54",
    "wagmi": "^2.14.12"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.18",
    "playwright": "^1.63.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
